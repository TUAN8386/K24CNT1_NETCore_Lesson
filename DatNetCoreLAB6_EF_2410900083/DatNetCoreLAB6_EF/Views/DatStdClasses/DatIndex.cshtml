@model IEnumerable<DatStdClass>
@{
    ViewData["Title"] = "Danh sách lớp";
}
<h2>Danh sách lớp</h2>
<p><a class="btn btn-sm btn-success" asp-action="DatCreate">Thêm mới lớp</a></p>
<table class="table table-hover bg-white align-middle">
    <thead>
        <tr>
            <th>Mã lớp</th>
            <th>@Html.DisplayNameFor(model => model.ClassName)</th>
            <th>Sĩ số</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var datItem in Model)
        {
            <tr>
                <td>@datItem.Id</td>
                <td>@datItem.ClassName</td>
                <td>@datItem.Students.Count</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-action="DatEdit" asp-route-id="@datItem.Id">Edit</a>
                    <a class="btn btn-sm btn-success" asp-action="DatDetails" asp-route-id="@datItem.Id">Details</a>
                    <a class="btn btn-sm btn-danger" asp-action="DatDelete" asp-route-id="@datItem.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
