@model IEnumerable<DATUAN_LAB_6.Models.Product>

<div class="border p-3 my-4 bg-light">
    <h3 class="text-danger fw-bold border-bottom pb-2 mb-3">SẢN PHẨM NỔI BẬT (HOT PRODUCT)</h3>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 text-center shadow-sm">
                    <img src="@item.Image" class="card-img-top p-2" alt="@item.Name" style="height: 180px; object-fit: contain;">
                    <div class="card-body">
                        <h6 class="card-title text-truncate">@item.Name</h6>
                        <p class="card-text text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>
                        <a href="#" class="btn btn-outline-danger btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>