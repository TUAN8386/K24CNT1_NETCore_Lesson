@model DatStudent
@{
    ViewData["Title"] = "Xóa sinh viên";
}
<h2>Xóa sinh viên</h2>
<h4 class="text-danger">Bạn có chắc muốn xóa sinh viên này? Điểm của sinh viên cũng sẽ bị xóa.</h4>
<hr />
<div class="row">
    <div class="col-md-3">
        <img src="/images/avatars/@Model.StudentAvatar" class="img-fluid rounded border" alt="@Model.StudentName" />
    </div>
    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentName)</dt>
            <dd class="col-sm-9">@Model.StudentName</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentEmail)</dt>
            <dd class="col-sm-9">@Model.StudentEmail</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentPhone)</dt>
            <dd class="col-sm-9">@Model.StudentPhone</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentAddress)</dt>
            <dd class="col-sm-9">@Model.StudentAddress</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.StudentBirthday)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.StudentBirthday)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ClassId)</dt>
            <dd class="col-sm-9">@Model.StdClass?.ClassName</dd>
        </dl>
        
    </div>
</div>
<form asp-action="DatDelete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-sm btn-danger" />
    <a class="btn btn-sm btn-secondary" asp-action="DatIndex">Back to List</a>
</form>
