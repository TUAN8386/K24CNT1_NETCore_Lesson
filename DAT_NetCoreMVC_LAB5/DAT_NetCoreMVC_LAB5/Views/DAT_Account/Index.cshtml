@model IEnumerable<DAT_NetCoreMVC_LAB5.Models.DAT_Account>

@{
    ViewData["Title"] = "Danh sách Account";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách Account</h2>
        <a asp-action="Create" class="btn btn-primary">+ Thêm mới Account</a>
    </div>

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Ngày sinh</th>
                <th>Facebook</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.FullName</strong></td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.Address</td>
                        <td>@item.Birthday.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a href="@item.Facebook" target="_blank" class="btn btn-sm btn-outline-info">Link FB</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Chưa có tài khoản nào trong danh sách.</td>
                </tr>
            }
        </tbody>
    </table>
</div>