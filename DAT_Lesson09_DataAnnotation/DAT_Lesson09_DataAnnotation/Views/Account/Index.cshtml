@model IEnumerable<DAT_Lesson09_DataAnnotation.Models.RegisterViewModel>

@{
    ViewData["Title"] = "Danh sách tài khoản";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách tài khoản đã đăng ký</h2>
        <a asp-action="Register" class="btn btn-primary">+ Đăng ký tài khoản mới</a>
    </div>

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên đăng nhập</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Tuổi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Username</strong></td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.Age</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Chưa có bản ghi nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>