@model DatProduct
@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}
<h2>Thêm mới sản phẩm</h2>
<hr />
<form asp-action="DatCreate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Image" class="form-label"></label>
                        <input type="file" name="datImageFile" class="form-control" accept="image/*" />
                        <span asp-validation-for="Image" class="text-danger"></span>
                        
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descriptions" class="form-label"></label>
                        <textarea asp-for="Descriptions" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Descriptions" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="0">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SalePrice" class="form-label"></label>
                        <input asp-for="SalePrice" class="form-control" />
                        <span asp-validation-for="SalePrice" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <partial name="_DatStatusSelect" model="Model.Status" />
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>
    <input type="submit" value="Lưu lại" class="btn btn-sm btn-success" />
    <a class="btn btn-sm btn-danger" asp-action="DatIndex">Về danh sách</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
