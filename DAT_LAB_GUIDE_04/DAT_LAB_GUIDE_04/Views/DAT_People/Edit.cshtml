@model DAT_LAB_GUIDE_04.Models.DAT_People

@{
    ViewData["Title"] = "Cập nhật nhân sự";
}

<h1>Cập nhật thông tin</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Khóa chính ID để ẩn -->
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <!-- Hiển thị ảnh hiện tại + Chọn ảnh mới -->
            <div class="form-group mb-3">
                <label asp-for="Avatar" class="control-label d-block"></label>
                <img src="~/@Model.Avatar" style="width: 80px; height: 80px; margin-bottom: 8px;" class="img-thumbnail" />
                <input asp-for="Avatar" type="file" class="form-control" />
                <span asp-validation-for="Avatar" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Birthday" class="control-label"></label>
                <input asp-for="Birthday" type="date" class="form-control" value="@Model.Birthday.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Birthday" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Gender" class="control-label d-block"></label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="gCty" value="0" @(Model.Gender == 0 ? "checked" : "") />
                    <label class="form-check-label" for="gCty">Cty</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="gMale" value="1" @(Model.Gender == 1 ? "checked" : "") />
                    <label class="form-check-label" for="gMale">Nam</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="gFemale" value="2" @(Model.Gender == 2 ? "checked" : "") />
                    <label class="form-check-label" for="gFemale">Nữ</label>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Bio" class="control-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="3">@Model.Bio</textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>