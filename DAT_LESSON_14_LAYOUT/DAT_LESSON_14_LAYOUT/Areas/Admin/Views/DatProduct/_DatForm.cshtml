@model DatProduct

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group">
    <label asp-for="Name"></label> <span class="text-danger">*</span>
    <input asp-for="Name" class="form-control" maxlength="100" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CategoryId"></label> <span class="text-danger">*</span>
    <select asp-for="CategoryId" asp-items="ViewBag.DatCategoryList" class="form-control">
        <option value="">-- Chọn danh mục --</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="row">
    <div class="form-group col-md-6">
        <label asp-for="Price"></label> <span class="text-danger">*</span>
        <input asp-for="Price" class="form-control" type="number" min="0" step="any" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="form-group col-md-6">
        <label asp-for="SalePrice"></label>
        <input asp-for="SalePrice" class="form-control" type="number" min="0" step="any" />
        <span asp-validation-for="SalePrice" class="text-danger"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="Status"></label>
    <select asp-for="Status" class="form-control">
        <option value="1">Hiển thị</option>
        <option value="0">Ẩn</option>
    </select>
    <span asp-validation-for="Status" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Image"></label>
    <input type="file" name="imageFile" id="imageFile" class="form-control-file" accept=".jpg,.jpeg,.png,.gif,.webp" />
    <small class="form-text text-muted">Ảnh .jpg/.png/.gif/.webp, tối đa 2MB</small>
    <span asp-validation-for="Image" class="text-danger"></span>
    <img id="imagePreview" class="dat-preview @(string.IsNullOrEmpty(Model.Image) ? "d-none" : "")" src="@Model.Image" alt="" />
</div>

<div class="form-group">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" class="form-control" rows="4" maxlength="350"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
