@model DatMark
@{
    ViewData["Title"] = "Xóa điểm";
}
<h2>Xóa điểm</h2>
<h4 class="text-danger">Bạn có chắc muốn xóa điểm này?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">Sinh viên</dt>
    <dd class="col-sm-10">@Model.Student?.StudentName</dd>
    <dt class="col-sm-2">Môn học</dt>
    <dd class="col-sm-10">@Model.Subject?.SubjectName</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Score)</dt>
    <dd class="col-sm-10">@Model.Score</dd>
</dl>
<form asp-action="DatDelete" asp-route-subjectId="@Model.SubjectId" asp-route-studentId="@Model.StudentId">
    <input type="submit" value="Delete" class="btn btn-sm btn-danger" />
    <a class="btn btn-sm btn-secondary" asp-action="DatIndex">Back to List</a>
</form>
