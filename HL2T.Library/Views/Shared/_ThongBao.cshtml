@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> @tb
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i> @loi
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
