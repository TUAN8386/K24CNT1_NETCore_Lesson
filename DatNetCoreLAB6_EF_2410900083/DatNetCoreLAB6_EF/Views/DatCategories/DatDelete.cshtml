@model DatCategory
@{
    ViewData["Title"] = "Xóa danh mục";
    var datProductCount = (int)(ViewBag.DatProductCount ?? 0);
}
<h2>Xóa danh mục</h2>
@if (datProductCount > 0)
{
    <div class="alert alert-warning">Danh mục đang có @datProductCount sản phẩm, không thể xóa.</div>
}
else
{
    <h4 class="text-danger">Bạn có chắc muốn xóa danh mục này?</h4>
}
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedDate)</dd>
</dl>
<form asp-action="DatDelete">
    <input type="hidden" asp-for="Id" />
    @if (datProductCount == 0)
    {
        <input type="submit" value="Delete" class="btn btn-sm btn-danger" />
    }
    <a class="btn btn-sm btn-secondary" asp-action="DatIndex">Back to List</a>
</form>
