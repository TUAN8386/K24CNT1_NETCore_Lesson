@model DatSubject
@{
    ViewData["Title"] = "Thêm mới môn học";
}
<h2>Thêm mới môn học</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DatCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SubjectName" class="form-label"></label>
                <input asp-for="SubjectName" class="form-control" />
                <span asp-validation-for="SubjectName" class="text-danger"></span>
            </div>
            <input type="submit" value="Create" class="btn btn-sm btn-success" />
            <a class="btn btn-sm btn-danger" asp-action="DatIndex">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
