<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện HL2T</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark hl-topbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="hl-logo">HL2T</span> Thư viện HL2T
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Sach" asp-action="Index">Tra cứu sách</a></li>
                    @if (User.IsInRole(VaiTroNames.DocGia))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="PhieuMuon" asp-action="LichSu">Phiếu mượn của tôi</a></li>
                    }
                    @if (User.IsInRole(VaiTroNames.Admin) || User.IsInRole(VaiTroNames.ThuThu))
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Trang quản trị</a></li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a class="text-white text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @User.LayHoTen()
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="DoiMatKhau">Đổi mật khẩu</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item" type="submit">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-warning btn-sm fw-semibold" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        <partial name="_ThongBao" />
        @RenderBody()
    </main>

    <footer class="hl-footer py-3">
        <div class="container small">© @DateTime.Now.Year Hệ thống Quản lý Sách Thư viện HL2T · Khoa CNTT &amp; Chuyển đổi số</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
