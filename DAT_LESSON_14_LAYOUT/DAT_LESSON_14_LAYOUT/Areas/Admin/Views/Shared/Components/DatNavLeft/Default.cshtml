@using DAT_LESSON_14_LAYOUT.Areas.Admin.ViewComponents
@model List<DatMenuItem>
@{
    var current = ViewBag.DatCurrent as string;
}
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <a asp-area="Admin" asp-controller="DatDashboard" asp-action="Index" class="brand-link">
        <span class="brand-image img-circle elevation-3 dat-brand-logo">D</span>
        <span class="brand-text font-weight-light">DAT Admin</span>
    </a>

    <div class="sidebar">
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                <span class="img-circle elevation-2 dat-avatar"><i class="fas fa-user"></i></span>
            </div>
            <div class="info">
                <a href="#" class="d-block">Đinh Anh Tuấn</a>
            </div>
        </div>

        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                @foreach (var item in Model)
                {
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="@item.Controller" asp-action="@item.Action"
                           class="nav-link @(item.Controller == current ? "active" : "")">
                            <i class="nav-icon @item.Icon"></i>
                            <p>@item.Title</p>
                        </a>
                    </li>
                }
                <li class="nav-header">KHÁC</li>
                <li class="nav-item">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                        <i class="nav-icon fas fa-globe"></i>
                        <p>Về trang người dùng</p>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>
