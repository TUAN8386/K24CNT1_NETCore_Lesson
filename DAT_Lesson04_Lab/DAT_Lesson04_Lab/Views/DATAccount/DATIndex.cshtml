@{
    ViewData["Title"] = "Danh sách tài khoản";
    var accounts = ViewBag.DATAccounts as List<DAT_Lesson04_Lab.Models.DATAccount>;
}

<h2 class="my-3 text-primary">Danh sách tài khoản</h2>

<div class="row">
    @if (accounts != null)
    {
        @foreach (var item in accounts)
        {
            <div class="col-md-4 my-2">
                <div class="card h-100 shadow-sm">
                    <img src="@item.Avatar" class="card-img-top img-fluid" style="height: 220px; object-fit: cover;" alt="@item.Name">
                    <div class="card-body">
                        <h5 class="card-title text-dark">@item.Name</h5>
                        <p class="card-text text-muted">@item.Bio</p>
                        <a asp-controller="DATAccount"
                           asp-action="DATProfile"
                           asp-route-id="@item.Id"
                           class="btn btn-primary w-100">Xem Hồ Sơ</a>
                    </div>
                </div>
            </div>
        }
    }
</div>