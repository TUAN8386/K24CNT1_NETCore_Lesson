@model DatMark
@{
    ViewData["Title"] = "Sửa điểm";
}
<h2>Sửa điểm</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DatEdit" asp-route-subjectId="@Model.SubjectId" asp-route-studentId="@Model.StudentId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SubjectId" />
            <input type="hidden" asp-for="StudentId" />
            <div class="mb-3">
                <label class="form-label">Sinh viên</label>
                <input class="form-control" value="@Model.Student?.StudentName" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Môn học</label>
                <input class="form-control" value="@Model.Subject?.SubjectName" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Score" class="form-label"></label>
                <input asp-for="Score" class="form-control" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
            <input type="submit" value="Cập nhật" class="btn btn-sm btn-success" />
            <a class="btn btn-sm btn-danger" asp-action="DatIndex">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
