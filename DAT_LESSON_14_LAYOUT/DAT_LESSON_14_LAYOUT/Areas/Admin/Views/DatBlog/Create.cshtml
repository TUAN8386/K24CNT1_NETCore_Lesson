@model DatBlog
@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="card card-primary">
    <div class="card-header"><h3 class="card-title">Thêm bài viết mới</h3></div>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="card-body">
            <partial name="_DatForm" model="Model" />
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-default"><i class="fas fa-arrow-left"></i> Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xem trước ảnh khi chọn file
        $('#imageFile').on('change', function () {
            const f = this.files && this.files[0];
            if (f) { $('#imagePreview').attr('src', URL.createObjectURL(f)).removeClass('d-none'); }
        });
    </script>
}
