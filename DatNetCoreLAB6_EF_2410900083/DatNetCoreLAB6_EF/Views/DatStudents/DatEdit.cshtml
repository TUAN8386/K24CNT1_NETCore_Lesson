@model DatStudent
@{
    ViewData["Title"] = "Chỉnh sửa sinh viên";
}
<h2>Chỉnh sửa sinh viên</h2>
<hr />
<form asp-action="DatEdit" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="StudentAvatar" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="StudentName" class="form-label"></label>
                <input asp-for="StudentName" class="form-control" />
                <span asp-validation-for="StudentName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StudentEmail" class="form-label"></label>
                <input asp-for="StudentEmail" class="form-control" />
                <span asp-validation-for="StudentEmail" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StudentPhone" class="form-label"></label>
                <input asp-for="StudentPhone" class="form-control" />
                <span asp-validation-for="StudentPhone" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StudentAddress" class="form-label"></label>
                <input asp-for="StudentAddress" class="form-control" />
                <span asp-validation-for="StudentAddress" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="StudentBirthday" class="form-label"></label>
                <input asp-for="StudentBirthday" class="form-control" />
                <span asp-validation-for="StudentBirthday" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ClassId" class="form-label"></label>
                <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId">
                    <option value="0">-- Chọn lớp --</option>
                </select>
                <span asp-validation-for="ClassId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StudentAvatar" class="form-label"></label>
                <input type="file" name="datAvatarFile" class="form-control" accept="image/*" />
                <span asp-validation-for="StudentAvatar" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(Model.StudentAvatar))
                {
                    <div class="mt-2">
                        <img src="/images/avatars/@Model.StudentAvatar" class="dat-preview" alt="" />
                        <div class="form-text">Để trống nếu muốn giữ ảnh hiện tại</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <input type="submit" value="Cập nhật" class="btn btn-sm btn-success" />
    <a class="btn btn-sm btn-danger" asp-action="DatIndex">Back to List</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
