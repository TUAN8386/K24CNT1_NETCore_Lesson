@model DatCategory
@{
    ViewData["Title"] = "Chi tiết danh mục";
}
<h2>Chi tiết danh mục</h2>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
    <dd class="col-sm-10"><partial name="_DatStatusBadge" model="Model.Status" /></dd>
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedDate)</dd>
    <dt class="col-sm-2">Số sản phẩm</dt>
    <dd class="col-sm-10">@Model.Products.Count</dd>
</dl>
<div>
    <a class="btn btn-sm btn-primary" asp-action="DatEdit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-sm btn-secondary" asp-action="DatIndex">Back to List</a>
</div>
