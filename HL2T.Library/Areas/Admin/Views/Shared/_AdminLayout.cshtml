@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string c) => c == ctrl ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HL2T Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hl-admin">
    <div class="d-flex">
        <aside class="hl-side d-none d-md-block">
            <a class="hl-side-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span class="hl-logo">HL2T</span> HL2T Admin</a>
            <div class="hl-grp">Tổng quan</div>
            <a class="hl-it @Act("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <div class="hl-grp">Quản lý kho sách</div>
            <a class="hl-it @Act("DanhMuc")" asp-area="Admin" asp-controller="DanhMuc" asp-action="Index"><i class="bi bi-tags"></i> Danh mục sách</a>
            <a class="hl-it @Act("Sach")" asp-area="Admin" asp-controller="Sach" asp-action="Index"><i class="bi bi-book"></i> Quản lý sách</a>
            <div class="hl-grp">Mượn – trả</div>
            <a class="hl-it @(ctrl == "PhieuMuon" && ViewContext.RouteData.Values["action"]?.ToString() != "TraSach" ? "active" : "")" asp-area="Admin" asp-controller="PhieuMuon" asp-action="Index"><i class="bi bi-journal-text"></i> Phiếu mượn</a>
            <a class="hl-it @(ViewContext.RouteData.Values["action"]?.ToString() == "TraSach" ? "active" : "")" asp-area="Admin" asp-controller="PhieuMuon" asp-action="TraSach"><i class="bi bi-arrow-return-left"></i> Trả sách &amp; phạt</a>
            <a class="hl-it @Act("BienLai")" asp-area="Admin" asp-controller="BienLai" asp-action="Index"><i class="bi bi-receipt"></i> Biên lai phạt</a>
            <div class="hl-grp">Hệ thống</div>
            @if (User.IsInRole(VaiTroNames.Admin))
            {
                <a class="hl-it @Act("NguoiDung")" asp-area="Admin" asp-controller="NguoiDung" asp-action="Index"><i class="bi bi-people"></i> Người dùng</a>
            }
            <a class="hl-it @Act("ThongKe")" asp-area="Admin" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart"></i> Thống kê báo cáo</a>
            <a class="hl-it" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang độc giả</a>
        </aside>
        <div class="flex-grow-1 min-vh-100">
            <header class="hl-abar d-flex align-items-center px-4">
                <div>
                    <h5 class="mb-0 fw-bold text-primary">@ViewData["Title"]</h5>
                    <div class="small text-muted">@ViewData["Crumb"]</div>
                </div>
                <div class="ms-auto dropdown">
                    <a class="text-decoration-none text-dark dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i> @User.LayHoTen()
                        <span class="text-muted small">(@VaiTroNames.HienThi(User.IsInRole(VaiTroNames.Admin) ? VaiTroNames.Admin : VaiTroNames.ThuThu))</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">Thông tin cá nhân</a></li>
                        <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="DoiMatKhau">Đổi mật khẩu</a></li>
                        <li><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item">Đăng xuất</button></form></li>
                    </ul>
                </div>
            </header>
            <main class="p-4">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
