@model NguoiDungFormVM
@{
    ViewData["Title"] = Model.MaNguoiDung == 0 ? "Thêm tài khoản" : "Cập nhật tài khoản";
    ViewData["Crumb"] = "Hệ thống / Người dùng";
}
<div class="card border-0 shadow-sm" style="max-width:760px"><div class="card-body">
    <form asp-action="Save" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <input type="hidden" asp-for="MaNguoiDung" />
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="TenDangNhap" class="form-label fw-semibold"></label><input asp-for="TenDangNhap" class="form-control" /><span asp-validation-for="TenDangNhap" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="MatKhau" class="form-label fw-semibold"></label><input asp-for="MatKhau" class="form-control" placeholder="@(Model.MaNguoiDung == 0 ? "" : "Để trống nếu không đổi")" /><span asp-validation-for="MatKhau" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="HoTen" class="form-label fw-semibold"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label fw-semibold"></label><input asp-for="SoDienThoai" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="MaVaiTro" class="form-label fw-semibold"></label><select asp-for="MaVaiTro" asp-items="ViewBag.VaiTros" class="form-select"></select></div>
            <div class="col-12"><label asp-for="DiaChi" class="form-label fw-semibold"></label><input asp-for="DiaChi" class="form-control" /></div>
            <div class="col-12 form-check ms-2"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label"></label>
                <span asp-validation-for="TrangThai" class="text-danger small d-block"></span></div>
        </div>
        <div class="d-flex gap-2 mt-3"><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-primary">Lưu tài khoản</button></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
