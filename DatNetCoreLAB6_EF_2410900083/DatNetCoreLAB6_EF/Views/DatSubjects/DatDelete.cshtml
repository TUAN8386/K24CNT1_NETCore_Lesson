@model DatSubject
@{
    ViewData["Title"] = "Xóa môn học";
}
<h2>Xóa môn học</h2>
<h4 class="text-danger">Bạn có chắc muốn xóa môn học này?</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SubjectName)</dt>
    <dd class="col-sm-10">@Model.SubjectName</dd>
</dl>
<form asp-action="DatDelete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-sm btn-danger" />
    <a class="btn btn-sm btn-secondary" asp-action="DatIndex">Back to List</a>
</form>
