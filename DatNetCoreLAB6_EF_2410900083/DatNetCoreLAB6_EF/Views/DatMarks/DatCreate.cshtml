@model DatMark
@{
    ViewData["Title"] = "Nhập điểm";
}
<h2>Nhập điểm</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="DatCreate">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                    <option value="0">-- Chọn sinh viên --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SubjectId" class="form-label"></label>
                <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId">
                    <option value="0">-- Chọn môn học --</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Score" class="form-label"></label>
                <input asp-for="Score" class="form-control" />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
            <input type="submit" value="Create" class="btn btn-sm btn-success" />
            <a class="btn btn-sm btn-danger" asp-action="DatIndex">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
