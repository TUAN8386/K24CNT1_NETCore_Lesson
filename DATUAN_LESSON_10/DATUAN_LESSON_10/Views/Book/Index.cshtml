@model IEnumerable<DATUAN_LESSON_10.Models.Book>

@{
    ViewData["Title"] = "Danh sách Sách (Dữ liệu mẫu)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Quản lý Danh sách Sách (Mock Data)</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm mới Sách</a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã Sách</th>
                <th>Tên Sách</th>
                <th>Tác giả</th>
                <th>Giá bán</th>
                <th>Năm XB</th>
                <th>Thể loại</th>
                <th>Nhà xuất bản</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BookId</td>
                        <td class="fw-bold">@item.Title</td>
                        <td>@item.Author</td>
                        <td class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</td>
                        <td>@item.PublishedYear</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @(item.Category != null ? item.Category.CategoryName : "N/A")
                            </span>
                        </td>
                        <td>@(item.Publisher != null ? item.Publisher.PublisherName : "N/A")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Không có dữ liệu sách.</td>
                </tr>
            }
        </tbody>
    </table>
</div>