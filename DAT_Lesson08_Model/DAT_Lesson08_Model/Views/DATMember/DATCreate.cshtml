@model DAT_Lesson08_Model.Models.DATMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}

<div class="card p-3 my-3 shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Thêm mới thành viên</h3>
    </div>

    <div class="card-body">
        <form asp-action="DATCreate" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="DATUsername" class="form-label font-weight-bold"></label>
                <input asp-for="DATUsername" class="form-control" placeholder="Nhập tên tài khoản..." required />
                <span asp-validation-for="DATUsername" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DATPassword" class="form-label font-weight-bold"></label>
                <input asp-for="DATPassword" type="password" class="form-control" placeholder="Nhập mật khẩu..." required />
                <span asp-validation-for="DATPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DATFullName" class="form-label font-weight-bold"></label>
                <input asp-for="DATFullName" class="form-control" placeholder="Nhập họ và tên..." required />
                <span asp-validation-for="DATFullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DATEmail" class="form-label font-weight-bold"></label>
                <input asp-for="DATEmail" type="email" class="form-control" placeholder="Nhập email..." required />
                <span asp-validation-for="DATEmail" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Lưu thành viên
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}