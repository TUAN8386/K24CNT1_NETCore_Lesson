@model IEnumerable<DAT_NetCoreMVC_LAB5.Models.DAT_Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<DAT_NetCoreMVC_LAB5.Models.DAT_Category>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sản phẩm</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm sản phẩm mới</a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Giá chuẩn</th>
                <th>Giá KM</th>
                <th>Mô tả</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var cateName = categories?.FirstOrDefault(c => c.Id == item.CategoryId)?.Name ?? "N/A";
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <img src="@item.Image" alt="@item.Name" style="width: 70px; height: 70px; object-fit: cover;" class="img-thumbnail" />
                        </td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="badge bg-secondary">@cateName</span></td>
                        <td><del class="text-muted">@item.Price.ToString("N0") VNĐ</del></td>
                        <td><strong class="text-danger">@item.SalePrice.ToString("N0") VNĐ</strong></td>
                        <td>@item.Description</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Chưa có sản phẩm nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>